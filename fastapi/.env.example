GEMINI_API_KEY=

# =============================================================================
# TWILIO CONFIGURATION
# =============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_APP_SID=

# MongoDB Configuration
MONGO_URI=
DB_NAME=

# Audio Preprocessing (RNNoise noise suppression)
AUDIO_VAD_ENABLED=false
AUDIO_VAD_AGGRESSIVENESS=2
AUDIO_VAD_ONSET_FRAMES=2
AUDIO_VAD_HANGOVER_FRAMES=8
AUDIO_RNNOISE_PRE_UP_ENABLED=false
# Denoiser engine: 'none' or 'speex'or 'webrtc' (SpeexDSP high-pass filter via scipy)
AUDIO_DENOISE_ENGINE=webrtc
AUDIO_NS_LEVEL=3
AUDIO_AGC_ENABLED=true
AUDIO_DENOISE_CHUNK_MS=200

# AWS S3 Configuration (Optional, for recordings)
# AWS_BUCKET_NAME=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Public base URL this server is reachable at (Twilio/GHL webhooks point here)
WEBHOOK_BASE_URL=http://localhost:8000

# GEMINI_PROVIDER: 'vertex' or 'ai_studio'
GEMINI_PROVIDER=ai_studio
# GEMINI_MODEL_ID:
# - For Vertex: e.g. gemini-live-2.5-flash-native-audio
# - For AI Studio: e.g. gemini-3.1-flash-live-preview
GEMINI_MODEL_ID=gemini-3.1-flash-live-preview

# GHL_API_KEY: GoHighLevel Private Integration token
GHL_API_KEY=
# GHL_CALENDAR_ID: the GHL calendar to check availability against / book into.
GHL_CALENDAR_ID=

# GHL_AUTO_CALL_ON_LEAD: "true" to auto-place an outbound call the moment a lead
# webhook arrives from GHL. Leave "false" while mapping out real payload fields.
GHL_AUTO_CALL_ON_LEAD=false

# GHL_DEFER_BOOKING_TO_APPROVAL: "true" (default) means a booking made during a
# live call is never written to the real GHL calendar until staff clicks
# "Confirm" on the dashboard. Set "false" to book live during the call instead.
GHL_DEFER_BOOKING_TO_APPROVAL=true

# SECRET_KEY: used to sign JWTs and session cookies — set a real random value in production
SECRET_KEY=insecure-dev-key-change-me

# Background call-center ambience mixed into the AI's own voice (not the caller's).
# Subtle room noise + light echo so it doesn't sound like a dead-silent AI.
BACKGROUND_AMBIENCE_ENABLED=true
# Fraction of the AI voice's volume (0.0-1.0). Keep 0.10-0.20 for a subtle effect.
BACKGROUND_AMBIENCE_LEVEL=0.15
BACKGROUND_ECHO_LEVEL=0.12
